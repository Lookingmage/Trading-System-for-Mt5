# ============================================================
# MT5 Quantum AI — Environment Variables
# ============================================================
# IMPORTANT: Never share this file. Never commit this file.
# Fill in your real MT5 credentials at Step 5 (MT5 Connector).
# ============================================================

# --- MetaTrader 5 Account (fill in at Step 5) ---
MT5_LOGIN=
MT5_PASSWORD= 
MT5_SERVER=

# --- Trading Mode: backtest | demo | shadow | live ---
TRADING_MODE=live

# --- Database ---
DB_PATH=database/mt5_quantum_ai.db

# --- System ---
LOG_LEVEL=INFO
TIMEZONE=UTC
